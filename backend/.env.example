NODE_ENV=development
PORT=3000

# En desarrollo podés usar el superusuario que crea `docker compose`.
# En producción DATABASE_URL DEBE conectar como el rol `app_backend`
# (creado por la migración AddRowLevelSecurity), nunca como superusuario:
# un superusuario de Postgres siempre bypassea RLS sin excepción, así
# que las políticas de seguridad de la sección 5 de ARCHITECTURE.md
# simplemente no se aplicarían.
DATABASE_URL=postgres://usuario:password@localhost:5432/maqueta_tienda

JWT_ACCESS_SECRET=cambiar-por-un-secreto-fuerte
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-fuerte-distinto

REDIS_URL=redis://localhost:6379

# Uno o varios orígenes separados por coma. Actualizar con el dominio real
# del frontend en producción (default: Next.js en dev local).
CORS_ORIGIN=http://localhost:3000

# Captcha (Cloudflare Turnstile) — deshabilitado por defecto. Activar solo
# cuando el frontend tenga el widget integrado y exista un sitio real en
# Cloudflare Turnstile (ver CaptchaGuard).
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- Notificaciones de nuevas solicitudes (carrito y asesorías) ---
# Todos los canales son opcionales e independientes; si uno falla, los demás
# igual salen y la solicitud del cliente nunca se pierde.

# Correo por SMTP (Gmail: smtp.gmail.com / 587 / contraseña de APLICACIÓN,
# no la contraseña normal de la cuenta). Sin SMTP_HOST el canal queda apagado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Destinatario de las consultas del carrito (equipo de ventas).
VENTAS_EMAIL=
# SOLO PRUEBAS: si se define, TODO correo (incluido el de asesores) se
# redirige a esta dirección, con el asunto marcado [PRUEBA → original].
NOTIFICACIONES_EMAIL_OVERRIDE=

# WhatsApp de pruebas con CallMeBot (https://www.callmebot.com): número con
# código de país y la apikey que el bot entrega al autorizar ese número.
# En producción se reemplaza por WhatsApp Cloud API (Meta) o Twilio.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
