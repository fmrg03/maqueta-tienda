# URL del backend. En desarrollo local, el backend corre en el puerto 3000
# por defecto (ver backend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Número de WhatsApp de ventas, solo dígitos con código de país
# (ej. 584141234567). Si está vacío, el botón de WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=
